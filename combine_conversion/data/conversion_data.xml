<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_conversion_order" model="ir.sequence">
        <field name="name">Conversion Order</field>
        <field name="code">combine.conversion.order</field>
        <field name="prefix">CNV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="product_conversion_charges" model="product.product">
        <field name="name">Conversion / Processing Charges</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="list_price">0</field>
    </record>

    <record id="category_yarn_processing" model="combine.conversion.category">
        <field name="name">Yarn Processing</field>
        <field name="code">YRN</field>
        <field name="sequence">10</field>
        <field name="description">Doubling, twisting, re-winding, cone-to-cone and similar yarn conversions.</field>
    </record>
    <record id="category_dyeing" model="combine.conversion.category">
        <field name="name">Dyeing &amp; Finishing</field>
        <field name="code">DYE</field>
        <field name="sequence">20</field>
        <field name="description">Yarn / fabric dyeing, bleaching, mercerising and finishing.</field>
    </record>
    <record id="category_weaving" model="combine.conversion.category">
        <field name="name">Weaving / Knitting</field>
        <field name="code">WVG</field>
        <field name="sequence">30</field>
        <field name="description">Conversion of yarn into fabric at a weaving or knitting unit.</field>
    </record>
</odoo>
