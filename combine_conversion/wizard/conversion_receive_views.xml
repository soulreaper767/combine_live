<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conversion_receive_form" model="ir.ui.view">
        <field name="name">combine.conversion.receive.form</field>
        <field name="model">combine.conversion.receive</field>
        <field name="arch" type="xml">
            <form string="Receive Converted Goods">
                <group>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="output_product_id"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="packages"/>
                        <field name="weight_per_package"/>
                        <label for="qty"/>
                        <div class="o_row">
                            <field name="qty"/>
                            <field name="output_uom_id" readonly="1"/>
                        </div>
                        <field name="waste_qty" invisible="not waste_product_id"/>
                        <field name="waste_product_id" invisible="1"/>
                        <field name="note"/>
                    </group>
                </group>
                <footer>
                    <button name="action_receive" type="object" string="Receive" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
