<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="yapie_report_type_list" model="ir.ui.view">
        <field name="name">yapie.report.type.list</field>
        <field name="model">yapie.report.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="example" string="Ask with"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="available" string="Available here"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="yapie_report_type_form" model="ir.ui.view">
        <field name="name">yapie.report.type.form</field>
        <field name="model">yapie.report.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Not installed" bg_color="text-bg-warning" invisible="available"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Who may get it">
                            <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="user_ids" widget="many2many_avatar_user" options="{'no_create': True}"/>
                            <div colspan="2" class="text-muted">Yapie administrators always may. It also runs with each person's own Odoo access rights,
                                so they only see records Odoo already shows them.</div>
                        </group>
                        <group string="In chat">
                            <field name="keywords"/>
                            <field name="example"/>
                            <field name="needs_partner"/>
                            <field name="default_period"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What it shows"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_yapie_report_types" model="ir.actions.act_window">
        <field name="name">Reports in chat</field>
        <field name="res_model">yapie.report.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html"><p>Choose who may ask the bot for each report.</p></field>
    </record>

    <record id="yapie_schedule_list" model="ir.ui.view">
        <field name="name">yapie.report.schedule.list</field>
        <field name="model">yapie.report.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="report_type_id"/>
                <field name="frequency"/>
                <field name="recipient_ids" widget="many2many_avatar_user"/>
                <field name="chat_ids" widget="many2many_tags"/>
                <field name="next_run"/>
                <field name="last_note" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="yapie_schedule_form" model="ir.ui.view">
        <field name="name">yapie.report.schedule.form</field>
        <field name="model">yapie.report.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_now" type="object" string="Send now" class="btn-primary" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Monday receivables"/></h1></div>
                    <group>
                        <group string="Report">
                            <field name="report_type_id" options="{'no_create': True}"/>
                            <field name="needs_partner" invisible="1"/>
                            <field name="report_code" invisible="1"/>
                            <field name="partner_id" invisible="needs_partner == 'no'" required="needs_partner == 'required'"/>
                            <field name="text_filter" invisible="report_code != 'stock_onhand'"/>
                            <field name="period"/>
                            <field name="fmt" widget="radio" options="{'horizontal': true}"/>
                            <field name="run_as_id" options="{'no_create': True}"/>
                        </group>
                        <group string="When">
                            <field name="frequency"/>
                            <field name="weekday" invisible="frequency != 'weekly'"/>
                            <field name="month_day" invisible="frequency != 'monthly'"/>
                            <field name="hour"/>
                            <field name="next_run"/>
                            <field name="last_run"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Who gets it">
                        <field name="recipient_ids" widget="many2many_avatar_user" options="{'no_create': True}"/>
                        <field name="chat_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <div class="text-muted">Each person must be allowed to get this report and have linked Yapie. A group only gets it when
                        every member is such a person — otherwise it is skipped and noted below.</div>
                    <group><field name="last_note"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_yapie_schedules" model="ir.actions.act_window">
        <field name="name">Scheduled reports</field>
        <field name="res_model">yapie.report.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html"><p>Send a report on a schedule — e.g. every Monday at 9:00, last week's sales to the sales managers.</p></field>
    </record>
</odoo>
