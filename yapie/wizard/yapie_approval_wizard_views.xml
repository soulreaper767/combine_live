<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="yapie_approval_wizard_form" model="ir.ui.view">
        <field name="name">yapie.approval.wizard.form</field>
        <field name="model">yapie.approval.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <group>
                    <field name="rule_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send for approval" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
