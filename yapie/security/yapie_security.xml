<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_yapie" model="ir.module.category">
        <field name="name">Yapie</field>
        <field name="sequence">60</field>
    </record>
    <record id="privilege_yapie" model="res.groups.privilege">
        <field name="name">Yapie</field>
        <field name="category_id" ref="module_category_yapie"/>
        <field name="description">Who may use Yapie with this company: link their Yapie, get reports, approve.</field>
    </record>
    <record id="group_yapie_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_yapie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_yapie_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_yapie"/>
        <field name="implied_ids" eval="[(4, ref('group_yapie_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- people see their own activity and the approvals they asked for or must decide; administrators see all -->
    <record id="rule_yapie_log_own" model="ir.rule">
        <field name="name">Yapie activity: own</field>
        <field name="model_id" ref="model_yapie_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_yapie_user'))]"/>
    </record>
    <record id="rule_yapie_log_all" model="ir.rule">
        <field name="name">Yapie activity: all</field>
        <field name="model_id" ref="model_yapie_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_yapie_manager'))]"/>
    </record>
    <record id="rule_yapie_request_own" model="ir.rule">
        <field name="name">Yapie approvals: asked by me or waiting for me</field>
        <field name="model_id" ref="model_yapie_approval_request"/>
        <field name="domain_force">['|', ('requested_by', '=', user.id), ('approver_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_yapie_request_all" model="ir.rule">
        <field name="name">Yapie approvals: all</field>
        <field name="model_id" ref="model_yapie_approval_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_yapie_manager'))]"/>
    </record>
</odoo>
