<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prod_report_form" model="ir.ui.view">
        <field name="name">combine.prod.report.form</field>
        <field name="model">combine.prod.report</field>
        <field name="arch" type="xml">
            <form string="Production Report">
                <group>
                    <group string="Report">
                        <field name="report_kind" widget="radio"/>
                        <field name="detail" widget="radio"/>
                    </group>
                    <group string="Production dated">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group>
                    <group string="Group by (in this order)">
                        <field name="by_date"/>
                        <field name="by_unit"/>
                        <field name="by_categ"/>
                        <field name="by_item"/>
                    </group>
                    <group string="Filters">
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All production units"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All items"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All categories"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All users"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Generate Report" class="btn-primary"/>
                    <button name="action_print_xlsx" type="object" string="Generate Excel" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_prod_report_entries" model="ir.actions.act_window">
        <field name="name">Production Entries</field>
        <field name="res_model">combine.prod.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'entries'}</field>
    </record>
    <record id="action_prod_report_daily" model="ir.actions.act_window">
        <field name="name">Daily Production Report</field>
        <field name="res_model">combine.prod.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'daily'}</field>
    </record>
    <record id="action_prod_report_total" model="ir.actions.act_window">
        <field name="name">Total Production Report</field>
        <field name="res_model">combine.prod.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'total'}</field>
    </record>

    <record id="action_report_production" model="ir.actions.report">
        <field name="name">Production Report</field>
        <field name="model">combine.prod.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">combine_production.report_production</field>
        <field name="report_file">combine_production.report_production</field>
        <field name="print_report_name">'Production Report %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="partner_ledger_qty.paperformat_partner_statement"/>
        <field name="binding_model_id" eval="False"/>
    </record>
    <template id="report_production">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="partner_ledger_qty.register_doc"/></t></t>
    </template>
</odoo>
