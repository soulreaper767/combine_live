<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fifo_allocation_list" model="ir.ui.view">
        <field name="name">combine.fifo.allocation.list</field>
        <field name="model">combine.fifo.allocation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="beyond_stock">
                <field name="date"/>
                <field name="picking_id"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id"/>
                <field name="source_label"/>
                <field name="source_date" optional="show"/>
                <field name="quantity" sum="Total"/>
                <field name="unit_cost"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="value" sum="Total"/>
                <field name="beyond_stock" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="fifo_allocation_search" model="ir.ui.view">
        <field name="name">combine.fifo.allocation.search</field>
        <field name="model">combine.fifo.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="picking_id"/><field name="product_id"/><field name="partner_id"/><field name="source_production_id"/>
                <group>
                    <filter name="by_picking" string="Delivery" context="{'group_by': 'picking_id'}"/>
                    <filter name="by_product" string="Item" context="{'group_by': 'product_id'}"/>
                    <filter name="by_production" string="Production" context="{'group_by': 'source_production_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_fifo_allocation" model="ir.actions.act_window">
        <field name="name">Delivery FIFO Cost Lines</field>
        <field name="res_model">combine.fifo.allocation</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_picking_form_fifo_cost" model="ir.ui.view">
        <field name="name">stock.picking.form.fifo.cost</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fifo_cost" type="object" class="oe_stat_button" icon="fa-calculator"
                        invisible="not x_fifo_allocation_count">
                    <field name="x_fifo_allocation_count" widget="statinfo" string="FIFO Cost"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
