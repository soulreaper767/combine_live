<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_unit_cost" model="ir.ui.view">
        <field name="name">mrp.production.form.unit.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="x_unit_cost" readonly="state in ('done', 'cancel')"/>
                <field name="x_currency_id" invisible="1"/>
                <field name="x_production_value" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                <field name="x_unit_id" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_list_unit_cost" model="ir.ui.view">
        <field name="name">mrp.production.list.unit.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="x_unit_id" optional="show"/>
                <field name="x_unit_cost" optional="show"/>
                <field name="x_currency_id" column_invisible="1"/>
                <field name="x_production_value" optional="show" sum="Total" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
