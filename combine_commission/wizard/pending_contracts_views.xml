<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pending_contracts_wizard_form" model="ir.ui.view">
        <field name="name">combine.pending.contracts.wizard.form</field>
        <field name="model">combine.pending.contracts.wizard</field>
        <field name="arch" type="xml">
            <form string="Pending Contracts">
                <group>
                    <group string="Report">
                        <field name="layout" widget="radio" options="{'horizontal': true}"/>
                        <field name="detail" widget="radio"/>
                        <field name="show" widget="radio"/>
                    </group>
                    <group string="Contracts dated (Document Date)">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group string="Filters">
                    <group>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All customers"
                               domain="[('customer_rank', '>', 0)]"/>
                        <field name="party_type_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All party types"/>
                        <field name="order_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All contracts"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All salespersons"/>
                    </group>
                    <group>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All items"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All item categories"/>
                        <field name="agent_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All commission agents"/>
                        <field name="tax_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All tax rates"
                               context="{'active_test': False}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Generate Report" class="btn-primary"/>
                    <button name="action_print_xlsx" type="object" string="Generate Excel" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pending_contracts_wizard" model="ir.actions.act_window">
        <field name="name">Pending Contracts</field>
        <field name="res_model">combine.pending.contracts.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_report_pending_contracts" model="ir.actions.report">
        <field name="name">Pending Contracts</field>
        <field name="model">combine.pending.contracts.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">combine_commission.report_pending_contracts</field>
        <field name="report_file">combine_commission.report_pending_contracts</field>
        <field name="print_report_name">'Pending Contracts %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="partner_ledger_qty.paperformat_partner_statement"/>
        <field name="binding_model_id" eval="False"/>
    </record>
    <template id="report_pending_contracts">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="partner_ledger_qty.register_doc"/></t></t>
    </template>

    <menuitem id="menu_pending_contracts" name="Pending Contracts" parent="sale.menu_sale_report"
              action="action_pending_contracts_wizard" sequence="52"/>
</odoo>
