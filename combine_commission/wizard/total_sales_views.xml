<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_total_sales_wizard_form" model="ir.ui.view">
        <field name="name">combine.total.sales.wizard.form</field>
        <field name="model">combine.total.sales.wizard</field>
        <field name="arch" type="xml">
            <form string="Total Sales Report">
                <group>
                    <group string="Group by (one or more, in this order)">
                        <field name="by_party"/>
                        <field name="by_item"/>
                        <field name="by_tax"/>
                        <field name="detail" widget="radio"/>
                    </group>
                    <group string="Invoices dated">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="include_refunds"/>
                    </group>
                </group>
                <group string="Filters">
                    <group>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All customers"
                               domain="[('customer_rank', '>', 0)]"/>
                        <field name="party_type_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All party types"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All salespersons"/>
                        <field name="created_by_ids" string="Created by" widget="many2many_tags" options="{'no_create': true}" placeholder="All users" context="{'active_test': False}"/>
                        <field name="agent_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All commission agents"/>
                    </group>
                    <group>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All items"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All item categories"/>
                        <field name="tax_ids" widget="many2many_tags" options="{'no_create': true}" placeholder="All tax rates"
                               context="{'active_test': False}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Generate Report" class="btn-primary"/>
                    <button name="action_print_xlsx" type="object" string="Generate Excel" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_total_sales_wizard" model="ir.actions.act_window">
        <field name="name">Total Sales Report</field>
        <field name="res_model">combine.total.sales.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_report_total_sales" model="ir.actions.report">
        <field name="name">Total Sales Report</field>
        <field name="model">combine.total.sales.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">combine_commission.report_total_sales</field>
        <field name="report_file">combine_commission.report_total_sales</field>
        <field name="print_report_name">'Total Sales Report %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="partner_ledger_qty.paperformat_partner_statement"/>
        <field name="binding_model_id" eval="False"/>
    </record>
    <template id="report_total_sales">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="partner_ledger_qty.register_doc"/></t></t>
    </template>

    <menuitem id="menu_total_sales" name="Total Sales Report" parent="sale.menu_sale_report"
              action="action_total_sales_wizard" sequence="49"/>
    <menuitem id="menu_total_sales_acc" name="Total Sales Report" parent="account.account_reports_partners_reports_menu"
              action="action_total_sales_wizard" sequence="19" groups="account.group_account_readonly,account.group_account_invoice"/>
</odoo>
