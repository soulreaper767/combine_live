<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission Bill - house style (same building blocks as the
         Custom Reports documents: cr_style, doc_style, cr_header). -->
    <record id="action_report_commission_bill" model="ir.actions.report">
        <field name="name">Commission Bill</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">combine_commission.report_commission_bill</field>
        <field name="report_file">combine_commission.report_commission_bill</field>
        <field name="print_report_name">'Commission Bill - %s' % (object.name or 'Draft').replace('/', '-')</field>
        <field name="paperformat_id" ref="partner_ledger_qty.paperformat_partner_statement"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="commission_bill_body">
        <t t-set="cb_lines" t-value="move._x_commission_lines().sorted(lambda l: (l.date or move.date, l.id))"/>
        <t t-set="cb_words" t-value="voucher_data(move)['words'] if voucher_data else move.currency_id.amount_to_text(move.amount_total)"/>
        <div class="page cr" t-att-style="'page-break-before: always;' if cr_break else None">
            <t t-call="partner_ledger_qty.cr_style"/>
            <t t-call="partner_ledger_qty.doc_style"/>
            <t t-call="partner_ledger_qty.cr_header">
                <t t-set="cr_title" t-value="'Commission Credit Note' if move.move_type == 'in_refund' else 'Commission Bill'"/>
                <t t-set="cr_company" t-value="move.company_id"/>
            </t>
            <table class="cr-info">
                <tr>
                    <td class="lbl">Bill No.</td>
                    <td><strong t-out="move.name or 'Draft'"/>
                        <span t-if="move.state != 'posted'" class="cr-stamp">NOT POSTED</span></td>
                    <td class="lbl">Date</td>
                    <td><span t-out="move.invoice_date or move.date" t-options="{'widget': 'date', 'format': 'dd-MMM-yy'}"/></td>
                    <td class="lbl">Status</td>
                    <td t-out="dict(move._fields['payment_state'].selection).get(move.payment_state) if move.state == 'posted' else dict(move._fields['x_approval_state'].selection).get(move.x_approval_state)"/>
                </tr>
                <tr>
                    <td class="lbl">Commission Agent</td>
                    <td><strong t-out="move.partner_id.name"/></td>
                    <td class="lbl">Reference</td>
                    <td colspan="3" t-out="move.ref or '-'"/>
                </tr>
            </table>
            <table class="cr-tbl">
                <colgroup>
                    <col style="width: 3.5%"/>
                    <col style="width: 11%"/>
                    <col style="width: 6.5%"/>
                    <col style="width: 17%"/>
                    <col style="width: 7%"/>
                    <col style="width: 15%"/>
                    <col style="width: 7%"/>
                    <col style="width: 11%"/>
                    <col style="width: 6%"/>
                    <col style="width: 0.5%"/>
                    <col style="width: 11%"/>
                </colgroup>
                <thead>
                    <tr>
                        <th>Sr.</th>
                        <th>Sales Invoice</th>
                        <th>Inv. Date</th>
                        <th>Customer</th>
                        <th>Contract</th>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Sales Value (Ex. GST)</th>
                        <th>Comm. %</th>
                        <th class="gap"/>
                        <th>Commission</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="cb_lines" t-as="cl">
                        <td class="c" t-out="cl_index + 1"/>
                        <td class="nw" t-out="cl.invoice_id.name"/>
                        <td class="c"><span t-out="cl.date" t-options="{'widget': 'date', 'format': 'dd-MMM-yy'}"/></td>
                        <td t-out="cl.partner_id.name"/>
                        <td class="nw" t-out="cl.sale_order_id.name"/>
                        <td t-out="cl.product_id.display_name"/>
                        <td class="n" t-out="'{:,.2f}'.format(cl.invoice_line_id.quantity)"/>
                        <td class="n" t-out="'{:,.0f}'.format(-cl.invoice_line_id.price_subtotal if cl.invoice_id.move_type == 'out_refund' else cl.invoice_line_id.price_subtotal)"/>
                        <td class="c" t-out="'{:g}'.format(cl.rate) + '%'"/>
                        <td class="gap"/>
                        <td class="n" t-out="'{:,.0f}'.format(cl.commission_amount)"/>
                    </tr>
                    <tr t-if="not cb_lines" t-foreach="move.invoice_line_ids" t-as="il">
                        <td class="c" t-out="il_index + 1"/>
                        <td colspan="8" t-out="il.name"/>
                        <td class="gap"/>
                        <td class="n" t-out="'{:,.0f}'.format(il.price_subtotal)"/>
                    </tr>
                    <tr class="tot">
                        <td colspan="9" class="c">TOTAL COMMISSION</td>
                        <td class="gap"/>
                        <td class="n" t-out="'{:,.0f}'.format(move.amount_total)"/>
                    </tr>
                </tbody>
            </table>
            <table class="cr-info" style="margin-top: 8px;" t-if="move.x_commission_wht_rate">
                <tr>
                    <td class="lbl">Withholding tax</td>
                    <td><t t-out="'{:g}'.format(move.x_commission_wht_rate)"/>% = <t t-out="'{:,.0f}'.format(move.x_commission_wht_amount)"/></td>
                    <td class="lbl">Net payable</td>
                    <td><strong t-out="'{:,.0f}'.format(move.amount_total - move.x_commission_wht_amount)"/></td>
                </tr>
            </table>
            <div class="cr-words" t-if="cb_words">
                <span class="lbl">Amount in words:</span> <strong t-out="cb_words"/>
            </div>
            <table class="cr-sign">
                <tr>
                    <td>Prepared by<span t-out="move.create_uid.name"/></td>
                    <td>Checked by<span/></td>
                    <td>Approved by<span t-out="move.x_approved_by.name if 'x_approved_by' in move._fields else ''"/></td>
                    <td>Received by<span>Agent's signature</span></td>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_commission_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="move">
                <t t-set="cr_break" t-value="not move_first"/>
                <t t-if="move.x_is_commission_bill">
                    <t t-call="combine_commission.commission_bill_body"/>
                </t>
                <t t-else="">
                    <t t-call="partner_ledger_qty.voucher_body"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Whichever print a commission bill is printed with (Print, Send,
         portal) - the house-style invoice route - it comes out as the
         Commission Bill. -->
    <template id="report_fbr_invoice_commission" inherit_id="partner_ledger_qty.report_fbr_invoice">
        <xpath expr="//t[@t-if=&quot;move.move_type in ('out_invoice', 'out_refund')&quot;]" position="before">
            <t t-if="move.x_is_commission_bill">
                <t t-call="combine_commission.commission_bill_body"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-if=&quot;move.move_type in ('out_invoice', 'out_refund')&quot;]" position="attributes">
            <attribute name="t-elif">move.move_type in ('out_invoice', 'out_refund')</attribute>
            <attribute name="t-if"/>
        </xpath>
    </template>
</odoo>
