<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- lists: Sales Orders / Quotations (both inherit sale_order_tree) -->
    <record id="sale_order_tree_tax_rate" model="ir.ui.view">
        <field name="name">sale.order.list.tax_rate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_tax_rate" optional="show"/>
                <field name="x_tax_rates" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_tax_rate" model="ir.ui.view">
        <field name="name">purchase.order.list.tax_rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_tax_rate" optional="show"/>
                <field name="x_tax_rates" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_kpis_tree_tax_rate" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.tax_rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_tax_rate" optional="show"/>
                <field name="x_tax_rates" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_view_tree_tax_rate" model="ir.ui.view">
        <field name="name">purchase.order.view.list.tax_rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_tax_rate" optional="show"/>
                <field name="x_tax_rates" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_tax_rate" model="ir.ui.view">
        <field name="name">account.move.invoice.list.tax_rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_tax_rate" optional="show"/>
                <field name="x_tax_rates" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- search: filter by rate and Group By "Tax Rate" -->
    <record id="view_sales_order_filter_tax_rate" model="ir.ui.view">
        <field name="name">sale.order.search.tax_rate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_tax_rate"/>
                <filter string="Tax Rate" name="group_tax_rate" context="{'group_by': 'x_tax_rate'}"/>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_order_filter_tax_rate" model="ir.ui.view">
        <field name="name">purchase.order.filter.tax_rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_tax_rate"/>
                <filter string="Tax Rate" name="group_tax_rate" context="{'group_by': 'x_tax_rate'}"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_view_search_tax_rate" model="ir.ui.view">
        <field name="name">purchase.order.search.tax_rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_tax_rate"/>
                <filter string="Tax Rate" name="group_tax_rate" context="{'group_by': 'x_tax_rate'}"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_invoice_filter_tax_rate" model="ir.ui.view">
        <field name="name">account.move.invoice.search.tax_rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_tax_rate"/>
                <filter string="Tax Rate" name="group_tax_rate" context="{'group_by': 'x_tax_rate'}"/>
            </xpath>
        </field>
    </record>
</odoo>
