<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_production_batch" model="ir.sequence">
        <field name="name">Production Batch</field>
        <field name="code">combine.production.batch</field>
        <field name="prefix">PB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_wip_count" model="ir.sequence">
        <field name="name">Department Stock / WIP Count</field>
        <field name="code">combine.wip.count</field>
        <field name="prefix">WIP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_quality_test" model="ir.sequence">
        <field name="name">Quality Test</field>
        <field name="code">combine.quality.test</field>
        <field name="prefix">QT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_waste_collection" model="ir.sequence">
        <field name="name">Waste Collection Note</field>
        <field name="code">combine.waste.collection</field>
        <field name="prefix">WCN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
