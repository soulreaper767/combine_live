<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Create Bill" instead of "Upload Bill": the bill is made from the order, no file needed -->
    <record id="purchase_order_form_create_bill" model="ir.ui.view">
        <field name="name">purchase.order.form.create.bill</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='purchase_file_uploader']" position="replace">
                <button name="action_create_invoice" type="object" string="Create Bill" class="oe_highlight" data-hotkey="i"
                        invisible="state != 'purchase' or invoice_status != 'to invoice'"/>
                <button name="action_create_invoice" type="object" string="Create Bill" data-hotkey="i"
                        invisible="state != 'purchase' or invoice_status == 'to invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>
