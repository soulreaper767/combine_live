<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_document_date" model="ir.ui.view">
        <field name="name">sale.order.form.document.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="validity_date" position="before">
                <field name="x_document_date" readonly="state == 'cancel'"/>
            </field>
        </field>
    </record>
    <record id="sale_order_tree_document_date" model="ir.ui.view">
        <field name="name">sale.order.list.document.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_document_date" optional="show"/>
            </field>
        </field>
    </record>
    <record id="purchase_order_form_document_date" model="ir.ui.view">
        <field name="name">purchase.order.form.document.date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="x_document_date" readonly="state == 'cancel'"/>
            </field>
        </field>
    </record>
    <record id="purchase_order_view_tree_document_date" model="ir.ui.view">
        <field name="name">purchase.order.list.document.date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_document_date" optional="show"/>
            </field>
        </field>
    </record>
    <record id="purchase_order_kpis_tree_document_date" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.document.date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_document_date" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
