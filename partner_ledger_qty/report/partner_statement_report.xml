<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_partner_statement" model="report.paperformat">
        <field name="name">Partner Statement - A4 Landscape</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_partner_statement" model="ir.actions.report">
        <field name="name">Partner Statement</field>
        <field name="model">partner.ledger.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_ledger_qty.partner_statement_document</field>
        <field name="report_file">partner_ledger_qty.partner_statement_document</field>
        <field name="print_report_name">'Statement - %s' % (object.partner_id.name)</field>
        <field name="paperformat_id" ref="paperformat_partner_statement"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Built directly on web.html_container, NOT web.external_layout -
         that template draws its own automatic company letterhead, which
         duplicated/overlapped the header this report builds for itself
         (confirmed by testing: company name rendered twice). This report
         owns its entire header, once, deliberately. -->
    <template id="partner_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard_doc">
                <t t-set="data" t-value="get_statement_data(wizard_doc)"/>
                <div class="page pls-statement">
                    <div class="pls-doctitle">Partner Statement</div>
                    <table class="pls-letterhead">
                        <tr>
                            <td class="pls-letterhead-company">
                                <div class="pls-panel pls-panel-company">
                                    <table class="pls-company-block">
                                        <tr>
                                            <td t-if="data['company'].logo" class="pls-logo-cell">
                                                <img class="pls-logo" t-att-src="image_data_uri(data['company'].logo)"/>
                                            </td>
                                            <td>
                                                <div class="pls-company-name" t-out="data['company'].name"/>
                                                <div t-foreach="address_lines(data['company'].partner_id)" t-as="line" t-out="line"/>
                                                <div t-if="data['company'].phone">
                                                    <span class="pls-label">Tel </span><span t-out="data['company'].phone"/>
                                                </div>
                                                <div t-if="data['company'].email">
                                                    <span class="pls-label">Email </span><span t-out="data['company'].email"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                            <td class="pls-letterhead-party">
                                <div class="pls-panel pls-panel-party">
                                    <table class="pls-meta">
                                        <tr><td class="pls-label">Party Name</td><td><strong t-out="data['partner'].name"/></td></tr>
                                        <tr>
                                            <td class="pls-label">Period</td>
                                            <td>
                                                <strong>
                                                    <span t-out="data['date_from']" t-options="{'widget': 'date'}"/>
                                                    <span> to </span>
                                                    <span t-out="data['date_to']" t-options="{'widget': 'date'}"/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="table pls-table">
                        <thead>
                            <tr>
                                <th>Voucher Date</th>
                                <th>Voucher No.</th>
                                <th>Remarks</th>
                                <th>Item Name</th>
                                <th>Invoice Age</th>
                                <th>Gross Rate</th>
                                <th>Quantity</th>
                                <th>Discount</th>
                                <th>Net Rate</th>
                                <th>Ex. Amount</th>
                                <th>GST Rate</th>
                                <th>GST Amount</th>
                                <th class="pls-divider">Incl Amount</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="pls-opening-row">
                                <td colspan="12"><em>Opening Balance</em></td>
                                <td class="pls-divider"/>
                                <td/>
                                <td/>
                                <td class="pls-num">
                                    <span t-out="fmt_amount(data['opening_balance'])"/>
                                </td>
                            </tr>
                            <tr t-foreach="data['rows']" t-as="row">
                                <td><span t-out="row['voucher_date']" t-options="{'widget': 'date'}"/></td>
                                <td><strong t-out="row['voucher_no'] or ''"/></td>
                                <td><em t-out="row['remarks'] or ''"/></td>
                                <td><em t-out="row['item_name'] or ''"/></td>
                                <td class="pls-num">
                                    <span t-if="row['invoice_age'] is not None" t-out="row['invoice_age']"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_amount(row['gross_rate'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_amount(row['quantity'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_percent(row['discount'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_amount(row['net_rate'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_amount(row['ex_amount'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_percent(row['gst_rate'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_amount(row['gst_amount'])"/>
                                </td>
                                <td class="pls-num pls-divider">
                                    <span t-out="fmt_amount(row['incl_amount'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-if="row['debit']" t-out="fmt_amount(row['debit'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-if="row['credit']" t-out="fmt_amount(row['credit'])"/>
                                </td>
                                <td class="pls-num">
                                    <span t-out="fmt_amount(row['running_balance'])"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="pls-total-row">
                                <td colspan="12"><strong>Total</strong></td>
                                <td class="pls-divider"/>
                                <td class="pls-num"><strong t-out="fmt_amount(data['total_debit'])"/></td>
                                <td class="pls-num"><strong t-out="fmt_amount(data['total_credit'])"/></td>
                                <td class="pls-num"><strong t-out="fmt_amount(data['closing_balance'])"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <table class="pls-summary">
                        <tr><td class="pls-label"><em>Opening Balance</em></td><td class="pls-num"><strong t-out="fmt_amount(data['opening_balance'])"/></td></tr>
                        <tr><td class="pls-label">Total Debit</td><td class="pls-num"><strong t-out="fmt_amount(data['total_debit'])"/></td></tr>
                        <tr><td class="pls-label">Total Credit</td><td class="pls-num"><strong t-out="fmt_amount(data['total_credit'])"/></td></tr>
                        <tr class="pls-summary-closing">
                            <td><strong><u>Closing Balance</u></strong></td>
                            <td class="pls-num"><strong><u t-out="fmt_amount(data['closing_balance'])"/></strong></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="partner_statement_assets" model="ir.asset">
        <field name="name">Partner Statement report CSS</field>
        <field name="bundle">web.report_assets_common</field>
        <field name="path">partner_ledger_qty/static/src/css/partner_statement.css</field>
    </record>
</odoo>
