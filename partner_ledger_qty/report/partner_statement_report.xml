<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared A4 landscape format for this module's reports. -->
    <record id="paperformat_partner_statement" model="report.paperformat">
        <field name="name">Custom Reports - A4 Landscape</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="css_margins" eval="False"/>
    </record>

    <record id="action_report_partner_statement" model="ir.actions.report">
        <field name="name">Partner Ledger</field>
        <field name="model">partner.ledger.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_ledger_qty.partner_statement_document</field>
        <field name="report_file">partner_ledger_qty.partner_statement_document</field>
        <field name="print_report_name">'Partner Ledger - %s' % (object.partner_id.name)</field>
        <field name="paperformat_id" ref="paperformat_partner_statement"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Fields follow the user's Excel reference (partner_ledger.xlsx);
         look comes from the shared cr_style / cr_header templates. -->
    <template id="partner_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard_doc">
                <t t-set="data" t-value="get_statement_data(wizard_doc)"/>
                <div class="page cr">
                    <t t-call="partner_ledger_qty.cr_style"/>
                    <t t-call="partner_ledger_qty.cr_header">
                        <t t-set="cr_title">Partner Ledger</t>
                        <t t-set="cr_company" t-value="data['company']"/>
                        <t t-set="cr_party" t-value="data['partner']"/>
                        <t t-set="cr_date_from" t-value="data['date_from']"/>
                        <t t-set="cr_date_to" t-value="data['date_to']"/>
                    </t>

                    <table class="cr-tbl">
                        <colgroup>
                            <col style="width: 6.5%"/>
                            <col style="width: 9%"/>
                            <col style="width: 14%"/>
                            <col style="width: 8%"/>
                            <col style="width: 3.5%"/>
                            <col style="width: 5%"/>
                            <col style="width: 4%"/>
                            <col style="width: 3.5%"/>
                            <col style="width: 5%"/>
                            <col style="width: 6%"/>
                            <col style="width: 4%"/>
                            <col style="width: 5%"/>
                            <col style="width: 6%"/>
                            <col style="width: 0.5%"/>
                            <col style="width: 6.5%"/>
                            <col style="width: 6.5%"/>
                            <col style="width: 7%"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>V. No.</th>
                                <th>Remarks</th>
                                <th>Item</th>
                                <th>Inv Age</th>
                                <th>Gross Rate</th>
                                <th>Qty</th>
                                <th>Disc.</th>
                                <th>Net Rate</th>
                                <th>Ex. Amt</th>
                                <th>GST Rate</th>
                                <th>GST Amt</th>
                                <th>Incl. Amt</th>
                                <th class="gap"/>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="open">
                                <td class="c"><span t-out="data['date_from']" t-options="{'widget': 'date'}"/></td>
                                <td colspan="12">Opening balance</td>
                                <td class="gap"/>
                                <td class="n"/>
                                <td class="n"/>
                                <td class="n"><span t-out="fmt_amount(data['opening_balance'])"/></td>
                            </tr>
                            <tr t-foreach="data['rows']" t-as="row">
                                <td class="c"><span t-out="row['voucher_date']" t-options="{'widget': 'date'}"/></td>
                                <td class="nw"><span t-out="row['voucher_no'] or ''"/></td>
                                <td><span t-out="row['remarks'] or ''"/></td>
                                <td><span t-out="row['item_name'] or ''"/></td>
                                <td class="c"><span t-if="row['invoice_age'] is not None" t-out="row['invoice_age']"/></td>
                                <td class="n"><span t-out="fmt_amount(row['gross_rate'])"/></td>
                                <td class="n"><span t-out="fmt_amount(row['quantity'])"/></td>
                                <td class="c"><span t-out="fmt_percent(row['discount'])"/></td>
                                <td class="n"><span t-out="fmt_amount(row['net_rate'])"/></td>
                                <td class="n"><span t-out="fmt_amount(row['ex_amount'])"/></td>
                                <td class="c"><span t-out="fmt_percent(row['gst_rate'])"/></td>
                                <td class="n"><span t-out="fmt_amount(row['gst_amount'])"/></td>
                                <td class="n"><span t-out="fmt_amount(row['incl_amount'])"/></td>
                                <td class="gap"/>
                                <td class="n"><span t-if="row['debit']" t-out="fmt_amount(row['debit'])"/></td>
                                <td class="n"><span t-if="row['credit']" t-out="fmt_amount(row['credit'])"/></td>
                                <td class="n"><span t-out="fmt_amount(row['running_balance'])"/></td>
                            </tr>
                            <tr class="tot">
                                <td colspan="6" class="c">TOTAL</td>
                                <td class="n"><span t-out="fmt_amount(data['total_qty'])"/></td>
                                <td/>
                                <td/>
                                <td class="n"><span t-out="fmt_amount(data['total_ex'])"/></td>
                                <td/>
                                <td class="n"><span t-out="fmt_amount(data['total_gst'])"/></td>
                                <td class="n"><span t-out="fmt_amount(data['total_incl'])"/></td>
                                <td class="gap"/>
                                <td class="n"><span t-out="fmt_amount(data['total_debit'])"/></td>
                                <td class="n"><span t-out="fmt_amount(data['total_credit'])"/></td>
                                <td class="n"><span t-out="fmt_amount(data['closing_balance'])"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
