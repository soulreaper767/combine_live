<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_partner_statement" model="report.paperformat">
        <field name="name">Partner Statement - A4 Landscape</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_partner_statement" model="ir.actions.report">
        <field name="name">Partner Statement</field>
        <field name="model">partner.ledger.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_ledger_qty.partner_statement_document</field>
        <field name="report_file">partner_ledger_qty.partner_statement_document</field>
        <field name="print_report_name">'Statement - %s' % (object.partner_id.name)</field>
        <field name="paperformat_id" ref="paperformat_partner_statement"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="partner_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard_doc">
                <t t-set="data" t-value="get_statement_data(wizard_doc)"/>
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="data['company']"/>
                    <t t-set="company_partner" t-value="data['company'].partner_id"/>
                    <t t-set="statement_partner" t-value="data['partner']"/>
                    <div class="pls-statement">
                        <div class="row pls-header">
                            <div class="col-6 pls-party">
                                <h5 class="pls-party-label">From</h5>
                                <strong t-field="company_partner.name"/>
                                <div t-out="company_partner.contact_address"/>
                                <div t-if="company.vat">
                                    <span>Tax/VAT: </span><span t-out="company.vat"/>
                                </div>
                            </div>
                            <div class="col-6 pls-party pls-party-right text-end">
                                <h5 class="pls-party-label">Statement For</h5>
                                <strong t-field="statement_partner.name"/>
                                <div t-out="statement_partner.contact_address"/>
                                <div t-if="statement_partner.vat">
                                    <span>Tax/VAT: </span><span t-out="statement_partner.vat"/>
                                </div>
                            </div>
                        </div>

                        <h2 class="pls-title">Partner Statement</h2>
                        <div class="pls-subtitle">
                            <span t-out="data['date_from']" t-options="{'widget': 'date'}"/>
                            <span> to </span>
                            <span t-out="data['date_to']" t-options="{'widget': 'date'}"/>
                            <span class="pls-currency-note">
                                &#8212; Amounts in <span t-out="data['currency'].name"/>
                            </span>
                        </div>

                        <table class="table pls-table">
                            <thead>
                                <tr>
                                    <th>Voucher Date</th>
                                    <th>Voucher No.</th>
                                    <th>Remarks</th>
                                    <th>Item Name</th>
                                    <th class="text-end">Invoice Age</th>
                                    <th class="text-end">Gross Rate</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Discount</th>
                                    <th class="text-end">Net Rate</th>
                                    <th class="text-end">Ex. Amount</th>
                                    <th class="text-end">GST Rate</th>
                                    <th class="text-end">GST Amount</th>
                                    <th class="text-end pls-divider">Incl Amount</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="pls-opening-row">
                                    <td colspan="12"><em>Opening Balance</em></td>
                                    <td class="pls-divider"/>
                                    <td/>
                                    <td/>
                                    <td class="text-end">
                                        <span t-out="'%.2f' % data['opening_balance']"/>
                                    </td>
                                </tr>
                                <tr t-foreach="data['rows']" t-as="row">
                                    <td><span t-out="row['voucher_date']" t-options="{'widget': 'date'}"/></td>
                                    <td><span t-out="row['voucher_no'] or ''"/></td>
                                    <td><span t-out="row['remarks'] or ''"/></td>
                                    <td><span t-out="row['item_name'] or ''"/></td>
                                    <td class="text-end">
                                        <span t-if="row['invoice_age'] is not None" t-out="row['invoice_age']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="row['gross_rate'] is not None" t-out="'%.2f' % row['gross_rate']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="row['quantity'] is not None" t-out="'%.2f' % row['quantity']"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="row['discount'] is not None">
                                            <span t-out="'%.2f' % row['discount']"/><span>%</span>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="row['net_rate'] is not None" t-out="'%.2f' % row['net_rate']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="row['ex_amount'] is not None" t-out="'%.2f' % row['ex_amount']"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="row['gst_rate'] is not None">
                                            <span t-out="'%.2f' % row['gst_rate']"/><span>%</span>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="row['gst_amount'] is not None" t-out="'%.2f' % row['gst_amount']"/>
                                    </td>
                                    <td class="text-end pls-divider">
                                        <span t-if="row['incl_amount'] is not None" t-out="'%.2f' % row['incl_amount']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="row['debit']" t-out="'%.2f' % row['debit']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="row['credit']" t-out="'%.2f' % row['credit']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="'%.2f' % row['running_balance']"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="pls-total-row">
                                    <td colspan="12"><strong>Total</strong></td>
                                    <td class="pls-divider"/>
                                    <td class="text-end"><strong t-out="'%.2f' % data['total_debit']"/></td>
                                    <td class="text-end"><strong t-out="'%.2f' % data['total_credit']"/></td>
                                    <td class="text-end"><strong t-out="'%.2f' % data['closing_balance']"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="partner_statement_assets" model="ir.asset">
        <field name="name">Partner Statement report CSS</field>
        <field name="bundle">web.report_assets_common</field>
        <field name="path">partner_ledger_qty/static/src/css/partner_statement.css</field>
    </record>
</odoo>
