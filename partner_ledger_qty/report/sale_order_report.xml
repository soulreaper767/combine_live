<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_sale_order" model="ir.actions.report">
        <field name="name">Contract / Sales Order</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_ledger_qty.report_sale_order</field>
        <field name="report_file">partner_ledger_qty.report_sale_order</field>
        <field name="print_report_name">('Sales Order - %s' if object.state == 'sale' else 'Contract - %s') % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_partner_statement"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_purchase_order" model="ir.actions.report">
        <field name="name">RFQ / Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_ledger_qty.report_purchase_order</field>
        <field name="report_file">partner_ledger_qty.report_purchase_order</field>
        <field name="print_report_name">('Purchase Order - %s' if object.state in ('purchase', 'done') else 'RFQ - %s') % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_voucher"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_picking" model="ir.actions.report">
        <field name="name">Delivery Challan / Transfer</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_ledger_qty.report_picking</field>
        <field name="report_file">partner_ledger_qty.report_picking</field>
        <field name="print_report_name">'%s - %s' % ({'outgoing': 'Delivery Challan', 'incoming': 'Goods Receipt'}.get(object.picking_type_code, 'Transfer'), (object.name or '').replace('/', '-'))</field>
        <field name="paperformat_id" ref="paperformat_voucher"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Sales line table with discount: Contract / Sales Order and Sales Tax Invoice -->
    <template id="sales_lines_table">
        <table class="cr-tbl" style="font-size: 10.5px;">
            <thead>
                <tr>
                    <th style="width: 3%">Sr.</th>
                    <th t-att-style="'width: 17%' if o['has_hs'] else 'width: 22%'">Description of Goods</th>
                    <th t-if="o['has_hs']" style="width: 6%">HS Code</th>
                    <th style="width: 6%">Quantity</th>
                    <th style="width: 4%">UoM</th>
                    <th style="width: 6%">Rate</th>
                    <th style="width: 4%">Disc. %</th>
                    <th style="width: 6%">Discounted Rate</th>
                    <th style="width: 8%">Gross Value</th>
                    <th style="width: 7%">Discount</th>
                    <th style="width: 8%">Net Value (Excl. ST)</th>
                    <th style="width: 4%">ST Rate</th>
                    <th style="width: 7%">Sales Tax</th>
                    <th style="width: 9%">Value Incl. Sales Tax</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="o['rows']" t-as="r">
                    <td class="c" t-out="r['sr']"/>
                    <td><t t-out="r['desc']"/><div t-if="r['note']" style="color: #6b7280; font-size: 9.5px;" t-out="r['note']"/></td>
                    <td t-if="o['has_hs']" class="c" t-out="r['hs'] or '-'"/>
                    <td class="n" t-out="r['qty']"/>
                    <td class="c" t-out="r['uom']"/>
                    <td class="n" t-out="r['g_rate']"/>
                    <td class="c" t-out="r['disc_pct']"/>
                    <td class="n" t-out="r['d_rate']"/>
                    <td class="n" t-out="r['gross']"/>
                    <td class="n" t-out="r['disc']"/>
                    <td class="n" t-out="r['ex']"/>
                    <td class="c" t-out="r['tax_rate']"/>
                    <td class="n" t-out="r['tax']"/>
                    <td class="n" t-out="r['inc']"/>
                </tr>
                <tr class="tot">
                    <td t-att-colspan="3 if o['has_hs'] else 2" class="c">TOTAL</td>
                    <td class="n" t-out="o['qty_total']"/>
                    <td colspan="4"/>
                    <td class="n" t-out="o['gross_total']"/>
                    <td class="n" t-out="o['disc_total']"/>
                    <td class="n" t-out="o['ex_total']"/>
                    <td/>
                    <td class="n" t-out="o['tax_total']"/>
                    <td class="n" t-out="o['inc_total']"/>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- Shared order layout: Contract / Sales Order and RFQ / Purchase Order -->
    <template id="order_body">
        <div class="page cr" t-att-style="'page-break-before: always;' if cr_break else None">
            <t t-call="partner_ledger_qty.cr_style"/>
            <t t-call="partner_ledger_qty.doc_style"/>
            <t t-call="partner_ledger_qty.cr_header">
                <t t-set="cr_title" t-value="o['title']"/>
                <t t-set="cr_company" t-value="doc.company_id"/>
            </t>
            <t t-call="partner_ledger_qty.doc_info_boxes"/>
            <t t-if="o.get('discount_layout')"><t t-call="partner_ledger_qty.sales_lines_table"/></t>
            <t t-else="">
            <table class="cr-tbl">
                <colgroup>
                    <col style="width: 4%"/>
                    <col t-att-style="'width: 23%' if o['has_hs'] else 'width: 30%'"/>
                    <col t-if="o['has_hs']" style="width: 7%"/>
                    <col style="width: 8%"/>
                    <col style="width: 5%"/>
                    <col style="width: 9%"/>
                    <col style="width: 11%"/>
                    <col style="width: 6%"/>
                    <col style="width: 11%"/>
                    <col style="width: 12%"/>
                </colgroup>
                <thead>
                    <tr>
                        <th>Sr.</th>
                        <th>Description of Goods</th>
                        <th t-if="o['has_hs']">HS Code</th>
                        <th>Quantity</th>
                        <th>UoM</th>
                        <th>Rate (Excl. ST)</th>
                        <th>Value Excl. Sales Tax</th>
                        <th>ST Rate</th>
                        <th>Sales Tax</th>
                        <th>Value Incl. Sales Tax</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o['rows']" t-as="r">
                        <td class="c" t-out="r['sr']"/>
                        <td><t t-out="r['desc']"/><div t-if="r['note']" style="color: #6b7280; font-size: 10px;" t-out="r['note']"/></td>
                        <td t-if="o['has_hs']" class="c" t-out="r['hs'] or '-'"/>
                        <td class="n" t-out="r['qty']"/>
                        <td class="c" t-out="r['uom']"/>
                        <td class="n" t-out="r['rate']"/>
                        <td class="n" t-out="r['ex']"/>
                        <td class="c" t-out="r['tax_rate']"/>
                        <td class="n" t-out="r['tax']"/>
                        <td class="n" t-out="r['inc']"/>
                    </tr>
                    <tr class="tot">
                        <td t-att-colspan="3 if o['has_hs'] else 2" class="c">TOTAL</td>
                        <td class="n" t-out="o['qty_total']"/>
                        <td colspan="2"/>
                        <td class="n" t-out="o['ex_total']"/>
                        <td/>
                        <td class="n" t-out="o['tax_total']"/>
                        <td class="n" t-out="o['inc_total']"/>
                    </tr>
                </tbody>
            </table>
            </t>
            <div class="cr-words">
                <span class="lbl">Amount in words:</span> <strong t-out="o['words']"/>
            </div>
            <div class="cr-note" t-if="o['terms']">
                <span style="color: #6b7280;"><t t-out="o['terms_label']"/>:</span> <t t-out="o['terms']"/>
            </div>
            <t t-call="partner_ledger_qty.doc_signatures"/>
        </div>
    </template>

    <!-- info pairs (3 per row) + party boxes, shared by the document prints -->
    <template id="doc_info_boxes">
        <table class="cr-info">
            <t t-foreach="range(0, len(o['info']), 3)" t-as="i">
                <tr>
                    <t t-foreach="o['info'][i:i + 3]" t-as="pair">
                        <td class="lbl" t-out="pair[0]"/>
                        <td>
                            <t t-if="i == 0 and pair_first"><strong t-out="pair[1]"/>
                                <span t-if="o.get('cancelled')" class="cr-stamp">CANCELLED</span></t>
                            <t t-else="" t-out="pair[1]"/>
                        </td>
                    </t>
                </tr>
            </t>
        </table>
        <table class="cr-boxes" t-if="o['boxes']">
            <tr>
                <td t-foreach="o['boxes']" t-as="box">
                    <div class="cr-box-t" t-out="box['label']"/>
                    <div class="cr-box-n" t-out="box['partner'].name"/>
                    <div class="cr-box-l" t-out="box['address']"/>
                    <div class="cr-box-l"><span class="lbl">NTN</span><t t-out="box['ids']['ntn'] or '-'"/></div>
                    <div class="cr-box-l"><span class="lbl">STRN</span><t t-out="box['ids']['strn'] or '-'"/>
                        <t t-if="box['ids']['status']"> (<t t-out="box['ids']['status']"/>)</t></div>
                    <div class="cr-box-l" t-foreach="box['extra']" t-as="ex"><span class="lbl" t-out="ex[0]"/><t t-out="ex[1]"/></div>
                </td>
            </tr>
        </table>
    </template>

    <template id="doc_signatures">
        <table class="cr-sign">
            <tr>
                <td t-foreach="o['signatures']" t-as="sig"><t t-out="sig[0]"/><span t-out="sig[1]"/></td>
            </tr>
        </table>
    </template>

    <template id="report_sale_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="cr_break" t-value="not doc_first"/>
                <t t-set="o" t-value="order_data(doc)"/>
                <t t-call="partner_ledger_qty.order_body"/>
            </t>
        </t>
    </template>

    <template id="report_purchase_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="cr_break" t-value="not doc_first"/>
                <t t-set="o" t-value="po_data(doc)"/>
                <t t-call="partner_ledger_qty.order_body"/>
            </t>
        </t>
    </template>

    <!-- Delivery Challan / Receipt / Transfer: quantities and weights, no prices -->
    <template id="report_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="picking_data(doc)"/>
                <div class="page cr" t-att-style="'page-break-before: always;' if not doc_first else None">
                    <t t-call="partner_ledger_qty.cr_style"/>
                    <t t-call="partner_ledger_qty.doc_style"/>
                    <t t-call="partner_ledger_qty.cr_header">
                        <t t-set="cr_title" t-value="o['title']"/>
                        <t t-set="cr_company" t-value="doc.company_id"/>
                    </t>
                    <t t-call="partner_ledger_qty.doc_info_boxes"/>
                    <table class="cr-tbl">
                        <thead><tr><th t-foreach="o['columns']" t-as="col" t-out="col[0]"/></tr></thead>
                        <tbody>
                            <tr t-foreach="o['rows']" t-as="row">
                                <td t-foreach="row" t-as="cell" t-att-class="o['columns'][cell_index][1]" t-out="cell"/>
                            </tr>
                            <tr class="tot">
                                <t t-foreach="o['columns']" t-as="col">
                                    <td t-if="col_index == 0" class="c">TOTAL</td>
                                    <td t-elif="col_index in o['totals']" class="n" t-out="o['totals'][col_index]"/>
                                    <td t-else=""/>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                    <div class="cr-note" t-if="o['note']"><span style="color: #6b7280;">Notes:</span> <t t-out="o['note']"/></div>
                    <t t-call="partner_ledger_qty.doc_signatures"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
