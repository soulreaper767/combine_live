<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_sale_order" model="ir.actions.report">
        <field name="name">Contract / Sales Order</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">partner_ledger_qty.report_sale_order</field>
        <field name="report_file">partner_ledger_qty.report_sale_order</field>
        <field name="print_report_name">('Sales Order - %s' if object.state == 'sale' else 'Contract - %s') % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_voucher"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="sale_order_body">
        <t t-set="o" t-value="order_data(order)"/>
        <div class="page cr" t-att-style="'page-break-before: always;' if cr_break else None">
            <t t-call="partner_ledger_qty.cr_style"/>
            <t t-call="partner_ledger_qty.doc_style"/>
            <t t-call="partner_ledger_qty.cr_header">
                <t t-set="cr_title" t-value="o['title']"/>
                <t t-set="cr_company" t-value="order.company_id"/>
            </t>
            <table class="cr-info">
                <tr>
                    <td class="lbl" t-out="o['number_label']"/>
                    <td><strong t-out="order.name"/>
                        <span t-if="order.state == 'cancel'" class="cr-stamp">CANCELLED</span></td>
                    <td class="lbl">Date</td>
                    <td><span t-out="order.date_order" t-options="{'widget': 'date'}"/></td>
                    <td class="lbl" t-if="order.validity_date and order.state != 'sale'">Valid Until</td>
                    <td t-if="order.validity_date and order.state != 'sale'"><span t-out="order.validity_date" t-options="{'widget': 'date'}"/></td>
                </tr>
                <tr>
                    <td class="lbl">Payment Terms</td>
                    <td t-out="order.payment_term_id.name or '-'"/>
                    <td class="lbl">Salesperson</td>
                    <td t-out="order.user_id.name or '-'"/>
                    <td class="lbl">Buyer Ref.</td>
                    <td t-out="order.client_order_ref or '-'"/>
                </tr>
            </table>
            <table class="cr-boxes">
                <tr>
                    <td>
                        <div class="cr-box-t">Seller</div>
                        <div class="cr-box-n" t-out="o['supplier'].name"/>
                        <div class="cr-box-l" t-out="o['supplier_address']"/>
                        <div class="cr-box-l"><span class="lbl">NTN</span><t t-out="o['supplier_ids']['ntn'] or '-'"/></div>
                        <div class="cr-box-l"><span class="lbl">STRN</span><t t-out="o['supplier_ids']['strn'] or '-'"/></div>
                    </td>
                    <td>
                        <div class="cr-box-t">Buyer</div>
                        <div class="cr-box-n" t-out="o['buyer'].name"/>
                        <div class="cr-box-l" t-out="o['buyer_address']"/>
                        <div class="cr-box-l"><span class="lbl">NTN</span><t t-out="o['buyer_ids']['ntn'] or '-'"/></div>
                        <div class="cr-box-l"><span class="lbl">STRN</span><t t-out="o['buyer_ids']['strn'] or '-'"/>
                            <t t-if="o['buyer_ids']['status']"> (<t t-out="o['buyer_ids']['status']"/>)</t></div>
                        <div class="cr-box-l" t-if="o['delivery_address']"><span class="lbl">Deliver</span><t t-out="o['delivery_address']"/></div>
                    </td>
                </tr>
            </table>
            <table class="cr-tbl">
                <colgroup>
                    <col style="width: 4%"/>
                    <col t-att-style="'width: 23%' if o['has_hs'] else 'width: 30%'"/>
                    <col t-if="o['has_hs']" style="width: 7%"/>
                    <col style="width: 8%"/>
                    <col style="width: 5%"/>
                    <col style="width: 9%"/>
                    <col style="width: 11%"/>
                    <col style="width: 6%"/>
                    <col style="width: 11%"/>
                    <col style="width: 12%"/>
                </colgroup>
                <thead>
                    <tr>
                        <th>Sr.</th>
                        <th>Description of Goods</th>
                        <th t-if="o['has_hs']">HS Code</th>
                        <th>Quantity</th>
                        <th>UoM</th>
                        <th>Rate (Excl. ST)</th>
                        <th>Value Excl. Sales Tax</th>
                        <th>ST Rate</th>
                        <th>Sales Tax</th>
                        <th>Value Incl. Sales Tax</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o['rows']" t-as="r">
                        <td class="c" t-out="r['sr']"/>
                        <td><t t-out="r['desc']"/><div t-if="r['note']" style="color: #6b7280; font-size: 10px;" t-out="r['note']"/></td>
                        <td t-if="o['has_hs']" class="c" t-out="r['hs'] or '-'"/>
                        <td class="n" t-out="r['qty']"/>
                        <td class="c" t-out="r['uom']"/>
                        <td class="n" t-out="r['rate']"/>
                        <td class="n" t-out="r['ex']"/>
                        <td class="c" t-out="r['tax_rate']"/>
                        <td class="n" t-out="r['tax']"/>
                        <td class="n" t-out="r['inc']"/>
                    </tr>
                    <tr class="tot">
                        <td t-att-colspan="3 if o['has_hs'] else 2" class="c">TOTAL</td>
                        <td class="n" t-out="o['qty_total']"/>
                        <td colspan="2"/>
                        <td class="n" t-out="o['ex_total']"/>
                        <td/>
                        <td class="n" t-out="o['tax_total']"/>
                        <td class="n" t-out="o['inc_total']"/>
                    </tr>
                </tbody>
            </table>
            <div class="cr-words">
                <span class="lbl">Amount in words:</span> <strong t-out="o['words']"/>
            </div>
            <div class="cr-note" t-if="order.note">
                <span style="color: #6b7280;">Terms &amp; Conditions:</span> <t t-out="order.note"/>
            </div>
            <table class="cr-sign">
                <tr>
                    <td>Prepared by<span t-out="order.user_id.name or order.create_uid.name"/></td>
                    <td>Approved by<span/></td>
                    <td>Accepted by Buyer<span>Signature &amp; stamp</span></td>
                    <td>For <t t-out="order.company_id.name"/><span>Authorised signatory</span></td>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_sale_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-set="cr_break" t-value="not order_first"/>
                <t t-call="partner_ledger_qty.sale_order_body"/>
            </t>
        </t>
    </template>
</odoo>
